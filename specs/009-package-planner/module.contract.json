{
  "id": "009-package-planner",
  "status": "ready",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["PackagePlan v0.1", "live11_3_external_to_imported_v0.1-experimental", "fail_if_exists"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "required_checked_obligations": true,
  "required_obligations": [
    "DOCUMENTED_ONLY: rewrite handoff is snapshot-bound under ADR-005",
    "DOCUMENTED_ONLY: rescue rewrite profile remains laboratory-only",
    "REVIEW_ONLY: planner has no filesystem effects",
    "REVIEW_ONLY: target collisions and ambiguity block",
    "ENFORCED_BY_TEST: valid_lab_input_builds_copy_and_rewrite_plan",
    "ENFORCED_BY_TEST: duplicate_occurrences_share_audio_copy",
    "ENFORCED_BY_TEST: unresolved_decision_blocks_plan",
    "ENFORCED_BY_TEST: target_equal_to_source_is_rejected",
    "ENFORCED_BY_TEST: different_content_same_target_name_blocks",
    "ENFORCED_BY_TEST: unsupported_live_version_blocks_rewrite",
    "ENFORCED_BY_TEST: unsupported_relative_path_type_blocks_rewrite",
    "ENFORCED_BY_TEST: locator_mismatch_blocks_rewrite",
    "ENFORCED_BY_TEST: copy_only_mode_has_no_rewrite_operations",
    "ENFORCED_BY_TEST: package_plan_is_deterministic",
    "ENFORCED_BY_TEST: package_planner_is_pure",
    "ENFORCED_BY_TYPE: PackagePlanningRequest",
    "ENFORCED_BY_TYPE: PackagePlan",
    "ENFORCED_BY_TYPE: PackagePlanMetadata",
    "ENFORCED_BY_TYPE: PlannedSourceAls",
    "ENFORCED_BY_TYPE: CopyOperation",
    "ENFORCED_BY_TYPE: RewriteOperation",
    "ENFORCED_BY_TYPE: UnresolvedPackageRequirement",
    "ENFORCED_BY_TYPE: PackagePlanWarning",
    "ENFORCED_BY_TYPE: PackagePlanError"
  ],
  "required_tests": ["valid_lab_input_builds_copy_and_rewrite_plan", "duplicate_occurrences_share_audio_copy", "unresolved_decision_blocks_plan", "target_equal_to_source_is_rejected", "different_content_same_target_name_blocks", "unsupported_live_version_blocks_rewrite", "unsupported_relative_path_type_blocks_rewrite", "locator_mismatch_blocks_rewrite", "copy_only_mode_has_no_rewrite_operations", "package_plan_is_deterministic", "package_planner_is_pure"],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "PackagePlanningRequest": ["plan_id", "target_project_root", "planning_mode"],
    "PackagePlan": ["metadata", "source_als", "target_project_root", "copy_operations", "rewrite_operations", "unresolved_requirements", "plan_status", "warnings", "errors"],
    "PackagePlanMetadata": ["planner_version", "plan_schema_version", "plan_id", "planning_mode", "source_als_hash", "resolution_policy_version", "rewrite_ruleset_version", "required_asset_count", "copy_operation_count", "rewrite_operation_count", "unresolved_count", "warning_count", "error_count"],
    "PlannedSourceAls": ["source_als_path", "source_file_hash", "source_file_size", "target_relative_path", "ableton_document_version", "ableton_creator_version", "ableton_minor_version"],
    "CopyOperation": ["operation_id", "operation_kind", "source_path", "target_relative_path", "expected_source_sha256", "expected_source_size", "content_id", "collision_policy", "preconditions"],
    "RewriteOperation": ["operation_id", "required_asset_id", "dependency_id", "als_ref_id", "xml_locator", "source_als_hash", "old_path", "old_relative_path", "old_relative_path_type", "new_path", "new_relative_path", "new_relative_path_type", "fields_to_change", "rule_id", "support_status"],
    "UnresolvedPackageRequirement": ["required_asset_id", "decision_status", "reason"],
    "PackagePlanWarning": ["warning_id", "warning_code", "message", "required_asset_id"],
    "PackagePlanError": ["error_code", "message", "path"]
  },
  "expected_source_files": ["crates/rescue_packaging/src/package_planner.rs", "crates/rescue_packaging/src/package_planner_impl.rs", "crates/rescue_packaging/src/package_planner_operations.rs", "crates/rescue_packaging/src/package_planner_result.rs"],
  "quality_source_globs": ["crates/rescue_packaging/src/package_planner*.rs"],
  "guarded_source_globs": ["crates/rescue_packaging/src/package_planner*.rs"],
  "forbidden_guarded_source_patterns": [
    {"literal": "std::fs", "label": "filesystem access"},
    {"literal": "unwrap(", "label": "unwrap"},
    {"literal": "expect(", "label": "expect"}
  ],
  "allowed_dependency_names": ["rescue_analyzer", "rescue_catalog", "rescue_core", "rescue_resolution", "serde"],
  "quality_limits": {"max_source_file_lines": 280, "max_function_lines": 70}
}
