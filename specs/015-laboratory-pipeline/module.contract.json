{
  "id": "015-laboratory-pipeline",
  "status": "ready",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["LaboratoryPackageRequest v0.2", "UserSelectionSet v0.1", "LaboratoryPackageResult v0.1", "ready_for_manual_ableton_check"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "required_checked_obligations": true,
  "required_obligations": [
    "ENFORCED_BY_TEST: complete_pipeline_blocks_unconfirmed_candidate_before_staging",
    "ENFORCED_BY_TEST: confirmed_project_root_is_preserved_in_blocked_result",
    "ENFORCED_BY_TEST: missing_sample_blocks_before_staging",
    "ENFORCED_BY_TEST: ambiguous_same_name_candidates_block_before_staging",
    "ENFORCED_BY_TEST: existing_target_is_rejected_before_any_write",
    "ENFORCED_BY_TEST: dangling_output_symlink_is_rejected_before_any_write",
    "ENFORCED_BY_TEST: outputs_inside_confirmed_project_root_are_rejected",
    "ENFORCED_BY_TEST: ancestor_symlink_into_project_is_rejected",
    "ENFORCED_BY_TEST: case_variant_project_path_is_rejected",
    "ENFORCED_BY_TEST: unknown_project_root_blocks_before_inventory_and_writes",
    "ENFORCED_BY_TEST: zero_reference_project_blocks_before_staging",
    "ENFORCED_BY_TEST: unbounded_filesystem_root_is_rejected",
    "ENFORCED_BY_TEST: unsupported_live_version_blocks_before_staging",
    "ENFORCED_BY_TYPE: LaboratoryPackageRequest",
    "ENFORCED_BY_TYPE: LaboratoryPackageResult",
    "ENFORCED_BY_TYPE: LaboratoryPackageError",
    "REVIEW_ONLY: orchestration contains no duplicated ALS or matching policy",
    "REVIEW_ONLY: no write-capable stage runs before a ready package plan",
    "REVIEW_ONLY: completed discovery evidence is retained on output-scope rejection",
    "DOCUMENTED_ONLY: successful static validation still requires manual Ableton verification",
    "ENFORCED_BY_TEST: laboratory_command_requires_explicit_write_flag",
    "ENFORCED_BY_TEST: laboratory_command_accepts_bounded_inputs",
    "ENFORCED_BY_TEST: selected_missing_sample_completes_narrow_pipeline",
    "ENFORCED_BY_TEST: changed_selected_sample_blocks_before_staging",
    "ENFORCED_BY_TEST: selection_for_different_als_blocks_before_staging"
  ],
  "required_tests": [
    "complete_pipeline_blocks_unconfirmed_candidate_before_staging",
    "confirmed_project_root_is_preserved_in_blocked_result",
    "missing_sample_blocks_before_staging",
    "ambiguous_same_name_candidates_block_before_staging",
    "existing_target_is_rejected_before_any_write",
    "dangling_output_symlink_is_rejected_before_any_write",
    "outputs_inside_confirmed_project_root_are_rejected",
    "ancestor_symlink_into_project_is_rejected",
    "case_variant_project_path_is_rejected",
    "unknown_project_root_blocks_before_inventory_and_writes",
    "zero_reference_project_blocks_before_staging",
    "unbounded_filesystem_root_is_rejected",
    "unsupported_live_version_blocks_before_staging",
    "laboratory_command_requires_explicit_write_flag",
    "laboratory_command_accepts_bounded_inputs",
    "selected_missing_sample_completes_narrow_pipeline",
    "changed_selected_sample_blocks_before_staging",
    "selection_for_different_als_blocks_before_staging"
  ],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "LaboratoryPackageRequest": ["run_id", "source_als_path", "scan_roots", "max_scan_entries", "staging_root", "target_project_root", "private_ledger_path", "user_selection_set"],
    "LaboratoryPackageResult": ["pipeline_version", "run_id", "run_status", "completed_stage", "discovery", "als_read_model", "extraction", "path_observations", "assessment", "preflight", "inventory", "resolution", "package_plan", "staging", "rewrite", "validation", "manifests", "promotion", "errors"],
    "LaboratoryPackageError": ["error_code", "stage", "message"]
  },
  "expected_source_files": [
    "crates/rescue_pipeline/src/laboratory_pipeline.rs",
    "crates/rescue_pipeline/src/laboratory_pipeline_impl.rs",
    "crates/rescue_pipeline/src/laboratory_pipeline_inputs.rs",
    "crates/rescue_pipeline/src/laboratory_pipeline_read.rs",
    "crates/rescue_pipeline/src/laboratory_pipeline_resolve.rs",
    "crates/rescue_pipeline/src/laboratory_pipeline_write.rs",
    "cli/rescue-cli/src/laboratory_command.rs"
  ],
  "quality_source_globs": ["crates/rescue_pipeline/src/*.rs", "cli/rescue-cli/src/*.rs"],
  "guarded_source_globs": ["crates/rescue_pipeline/src/*.rs", "cli/rescue-cli/src/*.rs"],
  "forbidden_guarded_source_patterns": [
    {"literal": "remove_dir_all", "label": "recursive deletion"},
    {"literal": "remove_file", "label": "file deletion"},
    {"literal": "unwrap(", "label": "unwrap"},
    {"literal": "expect(", "label": "expect"}
  ],
  "allowed_dependency_names": ["clap", "rescue_analyzer", "rescue_application", "rescue_catalog", "rescue_core", "rescue_execution", "rescue_manifest", "rescue_packaging", "rescue_pipeline", "rescue_promotion", "rescue_resolution", "rescue_rewriter", "rescue_validation", "serde", "serde_json", "flate2", "roxmltree", "tempfile"],
  "quality_limits": {"max_source_file_lines": 360, "max_function_lines": 105}
}
