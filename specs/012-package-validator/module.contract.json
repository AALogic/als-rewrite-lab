{
  "id": "012-package-validator",
  "status": "ready",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["PackagePlan v0.5", "StagingExecutionResult v0.3", "ALSRewriteResult v0.1", "PackageValidationResult v0.4", "metadata-only", "leave_system_managed/portable_risk", "Ableton Project Info"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "required_checked_obligations": true,
  "required_obligations": [
    "ENFORCED_BY_TEST: complete_staging_and_exact_semantic_diff_pass_validation",
    "ENFORCED_BY_TEST: tampered_audio_fails_hash_validation",
    "ENFORCED_BY_TEST: unexpected_staged_file_is_rejected",
    "ENFORCED_BY_TEST: unrelated_xml_change_fails_semantic_diff",
    "ENFORCED_BY_TEST: historical_reference_change_fails_semantic_diff",
    "ENFORCED_BY_TEST: approved_field_value_mismatch_fails_validation",
    "ENFORCED_BY_TEST: changed_original_source_is_detected",
    "ENFORCED_BY_TEST: existing_final_target_blocks_validation",
    "ENFORCED_BY_TEST: missing_ableton_project_marker_blocks_validation",
    "ENFORCED_BY_TEST: symlink_ableton_project_marker_blocks_validation",
    "ENFORCED_BY_TEST: mismatched_run_contracts_are_rejected",
    "ENFORCED_BY_TEST: validation_is_read_only",
    "ENFORCED_BY_TEST: path_only_semantic_diff_preserves_relative_fields",
    "ENFORCED_BY_TEST: metadata_only_audio_validates_without_content_hash",
    "ENFORCED_BY_TEST: system_dependency_cannot_be_copied_or_rewritten",
    "ENFORCED_BY_TYPE: PackageValidationRequest",
    "ENFORCED_BY_TYPE: PackageValidationResult",
    "ENFORCED_BY_TYPE: PackageValidationMetadata",
    "ENFORCED_BY_TYPE: DirectoryValidationRecord",
    "ENFORCED_BY_TYPE: FileValidationRecord",
    "ENFORCED_BY_TYPE: SemanticDiffRecord",
    "ENFORCED_BY_TYPE: PackageValidationWarning",
    "ENFORCED_BY_TYPE: PackageValidationError",
    "REVIEW_ONLY: validator has no filesystem writes",
    "REVIEW_ONLY: success requires exact planned tree and semantic diff"
  ],
  "required_tests": [
    "complete_staging_and_exact_semantic_diff_pass_validation",
    "tampered_audio_fails_hash_validation",
    "unexpected_staged_file_is_rejected",
    "unrelated_xml_change_fails_semantic_diff",
    "historical_reference_change_fails_semantic_diff",
    "approved_field_value_mismatch_fails_validation",
    "changed_original_source_is_detected",
    "existing_final_target_blocks_validation",
    "missing_ableton_project_marker_blocks_validation",
    "symlink_ableton_project_marker_blocks_validation",
    "mismatched_run_contracts_are_rejected",
    "validation_is_read_only"
    ,"path_only_semantic_diff_preserves_relative_fields",
    "metadata_only_audio_validates_without_content_hash",
    "system_dependency_cannot_be_copied_or_rewritten"
  ],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "PackageValidationRequest": ["validation_id", "staging_root"],
    "PackageValidationResult": ["metadata", "staging_root", "final_target_root", "directory_records", "file_records", "semantic_diff_records", "validation_status", "warnings", "errors"],
    "PackageValidationMetadata": ["validator_version", "validation_schema_version", "validation_id", "plan_id", "execution_id", "rewrite_id", "source_als_hash", "planned_directory_count", "verified_directory_count", "planned_file_count", "verified_file_count", "planned_rewrite_count", "verified_rewrite_count", "warning_count", "error_count"],
    "DirectoryValidationRecord": ["operation_id", "target_relative_path", "purpose", "directory_status"],
    "FileValidationRecord": ["operation_id", "target_relative_path", "expected_sha256", "observed_sha256", "expected_size", "observed_size", "verification_method", "file_status"],
    "SemanticDiffRecord": ["operation_id", "als_ref_id", "xml_locator", "verified_fields", "diff_status"],
    "PackageValidationWarning": ["warning_code", "message"],
    "PackageValidationError": ["error_code", "message", "operation_id", "path"]
  },
  "expected_source_files": [
    "crates/rescue_validation/src/package_validator.rs",
    "crates/rescue_validation/src/package_validator_impl.rs",
    "crates/rescue_validation/src/package_validator_inputs.rs",
    "crates/rescue_validation/src/package_validator_directories.rs",
    "crates/rescue_validation/src/package_validator_files.rs",
    "crates/rescue_validation/src/package_validator_result.rs",
    "crates/rescue_validation/src/semantic_diff.rs"
  ],
  "quality_source_globs": ["crates/rescue_validation/src/*.rs"],
  "guarded_source_globs": ["crates/rescue_validation/src/*.rs"],
  "forbidden_guarded_source_patterns": [
    {"literal": "std::fs::write", "label": "filesystem write"},
    {"literal": "OpenOptions", "label": "filesystem write options"},
    {"literal": "remove_file", "label": "file deletion"},
    {"literal": "remove_dir", "label": "directory deletion"},
    {"literal": "rename(", "label": "filesystem mutation"},
    {"literal": "unwrap(", "label": "unwrap"},
    {"literal": "expect(", "label": "expect"}
  ],
  "allowed_dependency_names": ["flate2", "rescue_core", "rescue_execution", "rescue_packaging", "rescue_rewriter", "roxmltree", "serde", "sha2", "tempfile"],
  "quality_limits": {"max_source_file_lines": 340, "max_function_lines": 95}
}
