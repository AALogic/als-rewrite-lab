    "REVIEW_ONLY: the payload surface is invisible interaction geometry only",
    "FRONTEND_TEST: ready_character_and_parcel_share_one_sprite",
    "FRONTEND_TEST: native_drag_switches_to_empty_hands_without_duplicate_parcel",
    "FRONTEND_TEST: cancelled_and_failed_drag_restore_integrated_parcel",
    "FRONTEND_TEST: courier_canvas_scale_remains_stable_across_payload_states"
