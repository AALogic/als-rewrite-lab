{
  "id": "025-quick-copy-assistant",
  "status": "ready",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["QuickCopyLaunchContext v0.2", "Viewer", "Alternate", "module 029 ordered queue", "module 030 immutable waves", "unchanged module 024", "terminal for the active order", "Wyslij ponownie", "Finder-compatible floating overlay policy", "startup-ready boundary"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "hidden_uncertainty_gate": true,
  "required_checked_obligations": true,
  "required_obligations": [
    "DOCUMENTED_ONLY: quick mode reuses unchanged module 018 copy policy",
    "DOCUMENTED_ONLY: one Play is the explicit write consent for complete or incomplete execution",
    "DOCUMENTED_ONLY: every accepted launch becomes one ordered queue item",
    "DOCUMENTED_ONLY: Play starts immutable module-024 waves through module 030",
    "REVIEW_ONLY: React owns no ALS, package, rewrite or incomplete-copy policy",
    "REVIEW_ONLY: internal structured failures collapse only at the quick presentation boundary",
    "REVIEW_ONLY: character animation never hides or changes operation status",
    "DOCUMENTED_ONLY: a successful handoff ends the active order",
    "REVIEW_ONLY: completion copy is derived from backend handoff facts",
    "DOCUMENTED_ONLY: quick mode uses a Finder-compatible floating overlay policy and restores regular policy for the main window",
    "DOCUMENTED_ONLY: cold Open With requests are buffered until setup completes",
    "REVIEW_ONLY: policy reassertion never calls set_focus",
    "REVIEW_ONLY: quick mode accepts Finder interaction without forcing focus or applying an NSPanel-only style",
    "DOCUMENTED_ONLY: closing an idle courier discards its queued in-memory order",
    "DOCUMENTED_ONLY: the ready queue summary distinguishes packaged projects from requested projects",
    "REVIEW_ONLY: closing never cancels or discards a copy or delivery operation already in progress",
    "REVIEW_ONLY: transparent native input area expands only for visible speech or queue details",
    "DOCUMENTED_ONLY: inbound Finder intake and outbound parcel handoff have separate native owners",
    "REVIEW_ONLY: Tauri/Wry is the sole inbound Finder drop owner",
    "ENFORCED_BY_TEST: quick_window_presence_policy_is_fullscreen_and_finder_drop_capable",
    "ENFORCED_BY_TEST: startup_open_urls_are_deferred_until_runtime_is_ready",
    "ENFORCED_BY_TEST: startup_completion_precedes_normal_window_schedule",
    "ENFORCED_BY_TEST: quick_window_keeps_standard_appkit_input_contract",
    "ENFORCED_BY_TEST: quick_window_accepts_inactive_finder_interaction_without_forcing_focus",
    "ENFORCED_BY_TEST: compact_footprint_preserves_character_anchor",
    "ENFORCED_BY_TEST: expanded_footprint_is_clamped_to_visible_work_area",
    "ENFORCED_BY_TEST: warm_compact_window_uses_the_expanded_cursor_anchor",
    "ENFORCED_BY_TEST: tauri_wry_is_the_only_inbound_finder_drop_owner",
    "ENFORCED_BY_TEST: new_order_reset_leaves_native_drop_registration_untouched",
    "ENFORCED_BY_TEST: tauri_fallback_drop_uses_the_shared_finder_route",
    "ENFORCED_BY_TEST: finder_intake_accepts_only_regular_als_files",
    "ENFORCED_BY_TEST: finder_intake_rejects_symlinked_als_files",
    "FRONTEND_TEST: transparent area collapses when speech is hidden",
    "FRONTEND_TEST: speech gets the expanded presentation area only while visible",
    "FRONTEND_TEST: resize-generated pointer leave cannot immediately collapse speech",
    "FRONTEND_TEST: payload_held_sprite_normalizes_silhouette_without_resizing_character_frame",
    "FRONTEND_TEST: closing_discards_idle_session_but_preserves_active_work",
    "FRONTEND_TEST: closing_idle_courier_resets_collection_before_window_close",
    "FRONTEND_TEST: closing_active_courier_preserves_work_before_window_close",
    "FRONTEND_TEST: ready_queue_summary_counts_packaged_projects_against_requested_projects",
    "ENFORCED_BY_TEST: valid_single_als_open_request_is_accepted",
    "ENFORCED_BY_TEST: non_als_open_request_is_refused",
    "ENFORCED_BY_TEST: multiple_opened_urls_are_routed_in_order",
    "ENFORCED_BY_TEST: warm_launch_appends_to_active_collection",
    "ENFORCED_BY_TEST: finder_drop_reuses_quick_als_validation",
    "ENFORCED_BY_TEST: quick_launch_context_wire_contract_is_stable",
    "REVIEW_ONLY: quick mode reuses DesktopCopyPreview and DesktopCopyResult without policy fields",
    "FRONTEND_TEST: unable_preview_never_executes_copy",
    "FRONTEND_TEST: one_play_executes_incomplete_preview_without_second_prompt",
    "FRONTEND_TEST: quick_state_controls_follow_contract",
    "FRONTEND_TEST: quick_status_copy_is_deterministic",
    "FRONTEND_TEST: new_intake_overrides_a_stale_delivered_presentation_state",
    "FRONTEND_TEST: native_drag_switches_to_empty_hands_without_duplicate_parcel",
    "FRONTEND_TEST: ready_delivery_controls_do_not_repeat_the_destination_folder_action",
    "FRONTEND_TEST: completed_handoff_messages_match_the_delivery_channel",
    "FRONTEND_TEST: completed_handoff_hides_parcel_and_delivery_controls",
    "FRONTEND_TEST: retryable_handoff_keeps_the_parcel_and_delivery_controls",
    "FRONTEND_TEST: native_handoff_keeps_attempt_until_terminal_event",
    "FRONTEND_TEST: assistant_host_names_completed_retry_as_send_again",
    "ENFORCED_BY_TYPE: QuickCopyLaunchContext"
  ],
  "required_tests": [
    "valid_single_als_open_request_is_accepted",
    "non_als_open_request_is_refused",
    "multiple_opened_urls_are_routed_in_order",
    "warm_launch_appends_to_active_collection",
    "finder_drop_reuses_quick_als_validation",
    "quick_launch_context_wire_contract_is_stable",
    "quick_window_presence_policy_is_fullscreen_and_finder_drop_capable",
    "startup_open_urls_are_deferred_until_runtime_is_ready",
    "startup_completion_precedes_normal_window_schedule",
    "quick_window_keeps_standard_appkit_input_contract",
    "quick_window_accepts_inactive_finder_interaction_without_forcing_focus",
    "compact_footprint_preserves_character_anchor",
    "expanded_footprint_is_clamped_to_visible_work_area",
    "warm_compact_window_uses_the_expanded_cursor_anchor",
    "tauri_wry_is_the_only_inbound_finder_drop_owner",
    "new_order_reset_leaves_native_drop_registration_untouched",
    "tauri_fallback_drop_uses_the_shared_finder_route",
    "finder_intake_accepts_only_regular_als_files",
    "finder_intake_rejects_symlinked_als_files"
  ],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "QuickCopyLaunchContext": ["request_id", "source_als_path", "source_display_name", "launch_source"]
