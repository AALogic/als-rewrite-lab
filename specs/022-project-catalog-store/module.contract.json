{
  "id": "022-project-catalog-store",
  "status": "verified",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["ProjectCatalogStoreRequest v0.1", "StoredProjectCatalog", "retained_from_prior_scan", "already_current", "no SQLite in v0.1"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "required_checked_obligations": true,
  "required_obligations": [
    "DOCUMENTED_ONLY: v0.1 uses private JSON behind a replaceable adapter",
    "DOCUMENTED_ONLY: no concurrent-process writer is supported in v0.1",
    "REVIEW_ONLY: partial coverage cannot create absence or deletion claims",
    "REVIEW_ONLY: Store owns persistence and freshness, not grouping or UI policy",
    "REVIEW_ONLY: stored native paths remain private local data",
    "ENFORCED_BY_TEST: first_snapshot_persists_and_round_trips",
    "ENFORCED_BY_TEST: repeated_identical_snapshot_is_idempotent",
    "ENFORCED_BY_TEST: complete_scan_marks_unseen_records_stale",
    "ENFORCED_BY_TEST: partial_scan_retains_unseen_records_without_missing_claim",
    "ENFORCED_BY_TEST: changed_complete_scope_retains_unseen_records_without_stale_claim",
    "ENFORCED_BY_TEST: partial_scan_does_not_shrink_known_folder_membership",
    "ENFORCED_BY_TEST: changed_observation_updates_same_occurrence",
    "ENFORCED_BY_TEST: corrupt_or_unsupported_store_fails_without_overwrite",
    "ENFORCED_BY_TEST: failed_snapshot_is_rejected_without_write",
    "ENFORCED_BY_TEST: atomic_write_leaves_no_owned_temporary_files",
    "ENFORCED_BY_TEST: stored_bytes_are_deterministic",
    "ENFORCED_BY_TEST: store_diagnostics_contain_no_private_paths",
    "ENFORCED_BY_TEST: fake_application_service_uses_stored_catalog_contract",
    "ENFORCED_BY_TYPE: ProjectCatalogStoreRequest",
    "ENFORCED_BY_TYPE: ProjectCatalogStoreResult",
    "ENFORCED_BY_TYPE: ProjectCatalogLoadResult",
    "ENFORCED_BY_TYPE: StoredProjectCatalog",
    "ENFORCED_BY_TYPE: ProjectCatalogStoreMetadata",
    "ENFORCED_BY_TYPE: StoredProjectFolderRecord",
    "ENFORCED_BY_TYPE: StoredLiveSetRecord",
    "ENFORCED_BY_TYPE: ProjectCatalogStoreWarning",
    "ENFORCED_BY_TYPE: ProjectCatalogStoreError"
  ],
  "required_tests": [
    "first_snapshot_persists_and_round_trips",
    "repeated_identical_snapshot_is_idempotent",
    "complete_scan_marks_unseen_records_stale",
    "partial_scan_retains_unseen_records_without_missing_claim",
    "changed_complete_scope_retains_unseen_records_without_stale_claim",
    "partial_scan_does_not_shrink_known_folder_membership",
    "changed_observation_updates_same_occurrence",
    "corrupt_or_unsupported_store_fails_without_overwrite",
    "failed_snapshot_is_rejected_without_write",
    "atomic_write_leaves_no_owned_temporary_files",
    "stored_bytes_are_deterministic",
    "store_diagnostics_contain_no_private_paths",
    "fake_application_service_uses_stored_catalog_contract"
  ],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "ProjectCatalogStoreRequest": ["store_path", "coverage_scope_id", "snapshot"],
    "ProjectCatalogStoreResult": ["operation_status", "catalog", "warnings", "errors"],
    "ProjectCatalogLoadResult": ["load_status", "catalog", "errors"],
    "StoredProjectCatalog": ["metadata", "project_folders", "live_sets", "catalog_warnings"],
    "ProjectCatalogStoreMetadata": ["storage_schema_version", "revision", "coverage_scope_id", "last_snapshot_id", "last_scan_run_id", "last_scan_status", "coverage_status", "project_folder_count", "live_set_count", "observed_project_folder_count", "observed_live_set_count", "retained_project_folder_count", "retained_live_set_count", "stale_project_folder_count", "stale_live_set_count"],
    "StoredProjectFolderRecord": ["record", "freshness_status", "last_observed_scan_run_id"],
    "StoredLiveSetRecord": ["record", "freshness_status", "last_observed_scan_run_id"],
    "ProjectCatalogStoreWarning": ["warning_code", "message"],
    "ProjectCatalogStoreError": ["error_code", "message"]
  },
  "expected_source_files": [
    "crates/rescue_catalog/src/project_catalog_store.rs",
    "crates/rescue_catalog/src/project_catalog_store_validation.rs",
    "crates/rescue_catalog/src/project_catalog_store_merge.rs",
    "crates/rescue_catalog/src/project_catalog_store_io.rs",
    "crates/rescue_catalog/src/project_catalog_store_impl.rs",
    "crates/rescue_catalog/src/project_catalog_store_windows.rs"
  ],
  "quality_source_globs": ["crates/rescue_catalog/src/project_catalog_store*.rs"],
  "guarded_source_globs": ["crates/rescue_catalog/src/project_catalog_store*.rs"],
  "forbidden_output_fields": ["primary_set", "recommended_set", "project_work_id", "version_family", "content_identity", "match_score", "copy_operation", "rewrite_operation"],
  "forbidden_guarded_source_patterns": [
    {"literal": "canonicalize(", "label": "canonicalize"},
    {"literal": "flate2", "label": "ALS decompression"},
    {"literal": "unwrap(", "label": "unwrap"},
    {"literal": "expect(", "label": "expect"},
    {"literal": "rusqlite", "label": "SQLite dependency"}
  ],
  "allowed_dependency_names": ["serde", "serde_json", "sha2", "tempfile", "windows-sys"],
  "quality_limits": {"max_source_file_lines": 280, "max_function_lines": 80}
}
