{
  "id": "007-asset-inventory",
  "status": "ready",
  "guard_version": "0.2",
  "engineering_rules": {
    "document": "ENGINEERING_RULES.md",
    "version": "0.1",
    "required_sections": ["Purpose", "Clean Code", "Modularity", "Testability", "Error Handling", "Data Safety", "Project Hard Rules"]
  },
  "required_docs": ["spec.md", "plan.md", "tasks.md", "fixture-contract.md"],
  "required_spec_literals": ["AssetInventoryResult v0.1", "ContentRecord", "never follow file or directory symlinks"],
  "blocking_markers": ["BLOCKING_UNKNOWN", "Gate Status: UNKNOWN", "Gate Status: AMBIGUOUS", "Gate Status: CONFLICTING"],
  "required_checked_obligations": true,
  "required_obligations": [
    "DOCUMENTED_ONLY: selected roots are not a full-disk scan",
    "DOCUMENTED_ONLY: content identity is separate from file occurrence",
    "REVIEW_ONLY: scanner never follows symlinks",
    "REVIEW_ONLY: scanner has no resolution or package policy",
    "ENFORCED_BY_TEST: recognized_audio_files_are_hashed",
    "ENFORCED_BY_TEST: non_audio_files_are_ignored",
    "ENFORCED_BY_TEST: identical_content_keeps_distinct_occurrences",
    "ENFORCED_BY_TEST: same_name_different_content_stays_distinct",
    "ENFORCED_BY_TEST: symlinks_are_not_followed",
    "ENFORCED_BY_TEST: invalid_roots_fail_closed",
    "ENFORCED_BY_TEST: entry_limit_marks_scan_partial",
    "ENFORCED_BY_TEST: overlapping_roots_do_not_duplicate_paths",
    "ENFORCED_BY_TEST: inventory_is_read_only",
    "ENFORCED_BY_TEST: inventory_output_is_deterministic",
    "ENFORCED_BY_TEST: fake_resolution_consumer_uses_inventory_contract",
    "ENFORCED_BY_TYPE: AssetInventoryRequest",
    "ENFORCED_BY_TYPE: AssetInventoryResult",
    "ENFORCED_BY_TYPE: AssetInventoryMetadata",
    "ENFORCED_BY_TYPE: FileOccurrence",
    "ENFORCED_BY_TYPE: ContentRecord",
    "ENFORCED_BY_TYPE: AssetInventoryWarning",
    "ENFORCED_BY_TYPE: AssetInventoryError"
  ],
  "required_tests": ["recognized_audio_files_are_hashed", "non_audio_files_are_ignored", "identical_content_keeps_distinct_occurrences", "same_name_different_content_stays_distinct", "symlinks_are_not_followed", "invalid_roots_fail_closed", "entry_limit_marks_scan_partial", "overlapping_roots_do_not_duplicate_paths", "inventory_is_read_only", "inventory_output_is_deterministic", "fake_resolution_consumer_uses_inventory_contract"],
  "required_tests_must_not_be_ignored": true,
  "required_tests_must_have_substance": true,
  "public_contract_mode": "exact",
  "public_contract": {
    "AssetInventoryRequest": ["scan_run_id", "roots", "max_entries"],
    "AssetInventoryResult": ["metadata", "file_occurrences", "content_records", "warnings", "errors"],
    "AssetInventoryMetadata": ["inventory_version", "scan_run_id", "scan_status", "requested_root_count", "scanned_root_count", "entries_visited", "audio_file_count", "content_record_count", "skipped_symlink_count", "warning_count", "error_count"],
    "FileOccurrence": ["file_occurrence_id", "content_id", "source_root", "native_path", "relative_path", "filename", "extension", "file_size", "entry_kind", "observation_status"],
    "ContentRecord": ["content_id", "hash_algorithm", "digest", "file_size", "occurrence_ids"],
    "AssetInventoryWarning": ["warning_id", "warning_code", "message", "path"],
    "AssetInventoryError": ["error_code", "message", "path"]
  },
  "expected_source_files": ["crates/rescue_catalog/src/asset_inventory.rs", "crates/rescue_catalog/src/asset_inventory_impl.rs", "crates/rescue_catalog/src/asset_inventory_walk.rs", "crates/rescue_catalog/src/asset_inventory_hash.rs"],
  "quality_source_globs": ["crates/rescue_catalog/src/asset_inventory*.rs"],
  "guarded_source_globs": ["crates/rescue_catalog/src/asset_inventory*.rs"],
  "forbidden_output_fields": ["match_score", "selected_candidate", "resolution_decision", "copy_operation", "rewrite_operation"],
  "forbidden_guarded_source_patterns": [
    {"literal": "std::fs::write", "label": "write"},
    {"literal": "std::fs::remove", "label": "remove"},
    {"literal": "canonicalize(", "label": "canonicalize"},
    {"literal": "unwrap(", "label": "unwrap"},
    {"literal": "expect(", "label": "expect"}
  ],
  "allowed_dependency_names": ["serde", "serde_json", "sha2", "tempfile"],
  "quality_limits": {"max_source_file_lines": 260, "max_function_lines": 70}
}
